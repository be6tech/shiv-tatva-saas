# HRMS api-gateway (Render). Required on Vercel for check-in, leave, payroll writes.
# If unset on Vercel, server defaults to https://shivtatva-api-gateway.onrender.com
API_GATEWAY_URL=https://shivtatva-api-gateway.onrender.com
NEXT_PUBLIC_API_BASE_URL=https://shivtatva-api-gateway.onrender.com

# Supabase — contact form mirror (optional). Run supabase/contact_leads.sql first.
# Project URL (no /rest/v1 required). Data API: {NEXT_PUBLIC_SUPABASE_URL}/rest/v1/
NEXT_PUBLIC_SUPABASE_URL=https://vxgqknpzricfvjqrehzt.supabase.co
# Server only — used by POST /api/integrations/supabase-contact-lead (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheet — contact rows → **Contact** tab. See scripts/google-apps-script-contact-leads.gs
GOOGLE_CONTACT_SHEET_WEBAPP_URL=

# Google Sheet — careers applications → **Careers** tab. See scripts/google-apps-script-career-applications.gs
GOOGLE_CAREERS_SHEET_WEBAPP_URL=

# Password reset OTP — real email (pick one or both)
# Option A: Resend (https://resend.com) — works on localhost + Vercel after restart/redeploy
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Shiv Tatva <noreply@yourdomain.com>
#
# Option B: Google Apps Script (sends via your Gmail) — deploy scripts/google-apps-script-password-reset-otp.gs
# GOOGLE_PASSWORD_RESET_OTP_WEBAPP_URL=https://script.google.com/macros/s/.../exec
#
# If neither is set, dev only shows OTP on screen (NODE_ENV=development)

# Admin login (POST /api/auth/admin/*). Run supabase/admin_users.sql first.
# Employee login (POST /api/auth/employee/*). Run supabase/employee_users.sql first.
# Sessions use httpOnly cookies (GET /api/auth/session, POST /api/auth/logout).
# HRMS on Render: run supabase/hrms_schema.sql, set SUPABASE_* on Render, seed-hrms-tables.mjs (see services/api-gateway/.env.example).
# Server only — signs admin/employee JWT; must match api-gateway JWT_SECRET exactly
JWT_SECRET=dev_secret

# Server-only gateway URL for HRMS proxy (/api/hrms/*). Falls back to NEXT_PUBLIC_API_BASE_URL then localhost:4000
# API_GATEWAY_URL=http://localhost:4000
