# Public API gateway (browser). Leave unset in dev → http://localhost:4000. Production: set to your HTTPS API origin (no trailing slash), e.g. https://api.yourdomain.com
# NEXT_PUBLIC_API_BASE_URL=

# Supabase — contact form mirror (optional). Run supabase/contact_leads.sql first.
# Project URL (no /rest/v1 required). Data API: {NEXT_PUBLIC_SUPABASE_URL}/rest/v1/
NEXT_PUBLIC_SUPABASE_URL=https://vxgqknpzricfvjqrehzt.supabase.co
# Server only — used by POST /api/integrations/supabase-contact-lead (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheet — contact rows → **Contact** tab. See scripts/google-apps-script-contact-leads.gs
GOOGLE_CONTACT_SHEET_WEBAPP_URL=

# Google Sheet — careers applications → **Careers** tab. See scripts/google-apps-script-career-applications.gs
GOOGLE_CAREERS_SHEET_WEBAPP_URL=

# Admin login (POST /api/auth/admin/*). Run supabase/admin_users.sql first.
# Employee login (POST /api/auth/employee/*). Run supabase/employee_users.sql first.
# Server only — signs admin/employee JWT after Supabase password check
JWT_SECRET=

# Password reset OTP — Resend (Option A, recommended)
# 1. Create API key at https://resend.com/api-keys
# 2. For testing: PASSWORD_RESET_FROM_EMAIL=Shiv Tatva <onboarding@resend.dev>
#    (Resend test sender — OTP only goes to your Resend signup email until you verify a domain)
# 3. Production: verify domain at https://resend.com/domains then use e.g. noreply@yourdomain.com
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=Shiv Tatva <onboarding@resend.dev>

# Password reset OTP — SMTP fallback (optional, only if not using Resend)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM_EMAIL=Shiv Tatva <your@gmail.com>
