PORT=4000
JWT_SECRET=dev_secret

# Production HRMS persistence (recommended).
# 1. Run ../../apps/web/supabase/hrms_schema.sql (separate tables; preferred).
# 2. Set SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY on Render, redeploy.
# 3. Seed: node services/api-gateway/scripts/seed-hrms-tables.mjs
# GET /health should report storage: "supabase-tables".
# Optional legacy blob: hrms_store.sql + seed-hrms-store.mjs
# HRMS_USE_RELATIONAL_TABLES=false forces hrms_store JSON blob instead of tables.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Without Supabase, data is stored in data/db.json (local dev only).
